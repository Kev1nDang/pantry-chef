# Copy to backend/.env and fill in from your Supabase dashboard.

# Project Settings -> "Connect" -> Session pooler URI (works on IPv4 networks).
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Project Settings -> API -> Project URL. Used to fetch the JWT signing keys (JWKS).
SUPABASE_URL=https://<project-ref>.supabase.co

# Only needed if your project still signs tokens with the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# JSON list of origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:5173"]
