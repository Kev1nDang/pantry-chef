# Copy to .env.local (git-ignored) and fill in from your Supabase dashboard:
# Project Settings -> API. Both values are public by design (they ship to the browser).
# Leave them empty to run without sign-in: the pantry stays in localStorage and AI features are off.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key. Supabase's "Connect" panel names it VITE_SUPABASE_PUBLISHABLE_KEY; either name works.
VITE_SUPABASE_ANON_KEY=
# Google sign-in needs no variables here: it's turned on in Supabase (see "Sign-in" in the README).

# Optional: API origin for production builds. Leave empty in dev to use the Vite proxy (/api -> :8290).
VITE_API_URL=

# Optional: where the dev proxy sends /api, e.g. a deployed API instead of the local one.
# API_PROXY_TARGET=http://localhost:8290
