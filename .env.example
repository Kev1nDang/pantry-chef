# Copy to .env.local (git-ignored) and fill in from your Supabase dashboard:
# Project Settings -> API. Both values are public by design (they ship to the browser).
# Leave them empty to run without sign-in: the pantry stays in localStorage and AI features are off.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: API origin for production builds. Leave empty in dev to use the Vite proxy (/api -> :8000).
VITE_API_URL=

# Optional: where the dev proxy sends /api. Change it if port 8000 is taken on your machine
# (on Windows, Hyper-V/WSL can reserve it), e.g. http://localhost:8001.
# API_PROXY_TARGET=http://localhost:8000
